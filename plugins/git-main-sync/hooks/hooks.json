{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/sync-main.sh",
            "timeout": 30,
            "statusMessage": "main ブランチを最新化中..."
          }
        ]
      }
    ],
    "DirectoryAdded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/sync-main.sh",
            "timeout": 30,
            "statusMessage": "追加ディレクトリの main ブランチを最新化中..."
          }
        ]
      }
    ]
  }
}
