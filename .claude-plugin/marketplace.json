{
  "name": "custom-marketplace",
  "version": "0.1.0",
  "description": "Claude Codeプラグインのマーケットプレイス",
  "owner": {
    "name": "rfdnxbro"
  },
  "plugins": [
    {
      "name": "claude-code-workflow",
      "source": "./plugins/claude-code-workflow",
      "description": "Claude Code を使う際の個人的な作業スタイル（文体ガイド、判断ルール等）をスキルとして集約するプラグイン",
      "version": "0.2.0",
      "author": {
        "name": "rfdnxbro"
      },
      "homepage": "https://github.com/rfdnxbro/claude-code-marketplace/tree/main/plugins/claude-code-workflow",
      "repository": "https://github.com/rfdnxbro/claude-code-marketplace",
      "license": "MIT",
      "keywords": [
        "workflow",
        "writing-style",
        "personal"
      ],
      "category": "workflow"
    },
    {
      "name": "git-main-sync",
      "source": "./plugins/git-main-sync",
      "description": "新規セッション開始時や /add-dir での作業ディレクトリ追加時に、git管理下なら現在ブランチに応じてmainブランチをpullまたはfetchで最新化する",
      "version": "0.1.0",
      "author": {
        "name": "rfdnxbro"
      },
      "homepage": "https://github.com/rfdnxbro/claude-code-marketplace/tree/main/plugins/git-main-sync",
      "repository": "https://github.com/rfdnxbro/claude-code-marketplace",
      "license": "MIT",
      "keywords": [
        "git",
        "session-start",
        "hooks",
        "workflow",
        "personal"
      ],
      "category": "workflow"
    }
  ]
}
