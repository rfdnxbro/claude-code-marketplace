{
  "name": "custom-marketplace",
  "version": "0.1.0",
  "description": "Claude Codeプラグインのマーケットプレイス",
  "owner": {
    "name": "rfdnxbro"
  },
  "plugins": [
    {
      "name": "claude-code-workflow",
      "source": "./plugins/claude-code-workflow",
      "description": "Claude Code を使う際の個人的な作業スタイル（文体ガイド、判断ルール等）をスキルとして集約するプラグイン",
      "version": "0.2.0",
      "author": {
        "name": "rfdnxbro"
      },
      "homepage": "https://github.com/rfdnxbro/claude-code-marketplace/tree/main/plugins/claude-code-workflow",
      "repository": "https://github.com/rfdnxbro/claude-code-marketplace",
      "license": "MIT",
      "keywords": [
        "workflow",
        "writing-style",
        "personal"
      ],
      "category": "workflow"
    },
    {
      "name": "usage-gauge",
      "source": "./plugins/usage-gauge",
      "description": "入力欄の上にコンテキスト・5時間・週間・週間 Fable・クレジットの使用量ゲージを並べる mod",
      "version": "0.1.0",
      "author": {
        "name": "rfdnxbro"
      },
      "homepage": "https://github.com/rfdnxbro/claude-code-marketplace/tree/main/plugins/usage-gauge",
      "repository": "https://github.com/rfdnxbro/claude-code-marketplace",
      "license": "MIT",
      "keywords": [
        "mod",
        "usage",
        "rate-limit",
        "context"
      ],
      "category": "productivity"
    },
    {
      "name": "skill-preview",
      "source": "./plugins/skill-preview",
      "description": "入力中の /スキル名 や実行されたスキルの SKILL.md を右ペインに表示する mod",
      "version": "0.1.0",
      "author": {
        "name": "rfdnxbro"
      },
      "homepage": "https://github.com/rfdnxbro/claude-code-marketplace/tree/main/plugins/skill-preview",
      "repository": "https://github.com/rfdnxbro/claude-code-marketplace",
      "license": "MIT",
      "keywords": [
        "mod",
        "skills",
        "pane"
      ],
      "category": "productivity"
    }
  ]
}
